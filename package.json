{
  "name": "portal-de-atualização-cadastral-seguro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n WEB,API -c blue,green \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "npm run dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "npm --prefix server run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:server",
    "test:client": "node scripts/test-management-client.cjs && node scripts/test-member-finance.cjs",
    "test:integration": "npm --prefix server run test:integration",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "deploy": "gh-pages -d dist",
    "publish": "git add . && git commit -m 'update' && git push",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "gh-pages": "^5.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
